{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "rijksmuseum-iconclass",
  "version": "0.8.0",
  "description": "Search and browse the Iconclass art-subject classification: about 1.3 million notations in 13 languages, with keyword and semantic search and Rijksmuseum artwork counts, plus a research guidance skill.",
  "author": {
    "name": "RISE (University of Basel)",
    "url": "https://rise.unibas.ch"
  },
  "homepage": "https://github.com/kintopp/rijksmuseum-iconclass-mcp",
  "repository": "https://github.com/kintopp/rijksmuseum-iconclass-mcp",
  "license": "MIT",
  "keywords": [
    "iconclass",
    "iconography",
    "art",
    "classification",
    "museum"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Rijksmuseum Iconclass",
        "shortDescription": "Iconclass art-subject codes, with Rijksmuseum counts",
        "developerName": "RISE (University of Basel)",
        "category": "Productivity",
        "websiteURL": "https://github.com/kintopp/rijksmuseum-iconclass-mcp"
      }
    }
  }
